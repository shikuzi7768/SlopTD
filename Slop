                        elseif isAutoLobbyEnabled then
                            endDecisionRemote:FireServer(false)
                            StatusLabel.Text = "Status: Victory/Defeat!\nAuto Lobby Sent!"
                        end
                    end
                end)
            end
        end
        
        if isMatchActuallyStarted() and not isMatchEnded() then
            hasExecutedEndDecision = false
        end
    end
end)

