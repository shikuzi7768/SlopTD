-- AUTOMATION BACKGROUND LOOP ENGINE
-- ==========================================
task.spawn(function()
    while task.wait(1) do
        -- Auto Vote Map Logic
        if isAutoVoteEnabled then
            local voteRemote = getEventRemote({"VoteMap", "MapVote", "Vote", "ChooseMap", "SelectMap"})
            if voteRemote and MapNameBox.Text ~= "" then
                pcall(function()
                    if voteRemote:IsA("RemoteFunction") then
                        voteRemote:InvokeServer(MapNameBox.Text)
                    elseif voteRemote:IsA("RemoteEvent") then
                        voteRemote:FireServer(MapNameBox.Text)
                    end
                end)
            end
        end

        -- Auto Vote Difficulty Logic
        if isAutoVoteDiffEnabled then
            local diffRemote = getEventRemote({"VoteDifficulty", "DifficultyVote", "VoteDiff", "ChooseDifficulty", "SelectDifficulty", "Difficulty"})
            if diffRemote and DiffNameBox.Text ~= "" then
                pcall(function()
                    if diffRemote:IsA("RemoteFunction") then
                        diffRemote:InvokeServer(DiffNameBox.Text)
                    elseif diffRemote:IsA("RemoteEvent") then
                        diffRemote:FireServer(DiffNameBox.Text)
                    end
                end)
            end
        end

        -- Auto Skip Wave Logic
        if isAutoVoteSkipEnabled then
            local skipRemote = getEventRemote({"SkipWave", "VoteSkip", "Skip", "SkipWaveVote"})
            if skipRemote then
                pcall(function()
                    if skipRemote:IsA("RemoteFunction") then
                        skipRemote:InvokeServer()
                    elseif skipRemote:IsA("RemoteEvent") then
                        skipRemote:FireServer()
                    end
                end)
            end
        end

        -- Auto Ability Logic
        if isAutoAbilityEnabled then
            local abilityRemote = getEventRemote({"UseAbility", "Ability", "TowerAbility", "CastAbility"})
            if abilityRemote then
                pcall(function()
                    local towersFolder = Workspace:FindFirstChild("Towers") or Workspace
                    for _, tower in ipairs(towersFolder:GetChildren()) do
                        if tower:IsA("Model") then
                            if abilityRemote:IsA("RemoteFunction") then
                                abilityRemote:InvokeServer(tower)
                            elseif abilityRemote:IsA("RemoteEvent") then
                                abilityRemote:FireServer(tower)
                            end
                        end
                    end
                end)
            end
        end
    end
end)

