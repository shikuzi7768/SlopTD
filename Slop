saveConfigToFile = function()
    if not supportsFileSystem then return end
    local configData = {
        autoPlaySingle = isAutoPlaySingleEnabled,
        autoVote = isAutoVoteEnabled,
        autoVoteDiff = isAutoVoteDiffEnabled,
        speedMultiplier = currentSpeedMultiplier,
        autoSummonAmount = autoSummonAmount,
        autoPremSummonAmount = autoPremSummonAmount,
        autoCrateAmount = autoCrateAmount,
        autoBuyCrateAmount = autoBuyCrateAmount,
        autoAbility = isAutoAbilityEnabled,
        autoVoteSkip = isAutoVoteSkipEnabled,
        autoReplay = isAutoReplayEnabled,
        autoLobby = isAutoLobbyEnabled,
        mapName = MapNameBox.Text,
        diffName = DiffNameBox.Text,
        crateName = CrateNameBox.Text,
        selectedMacro = selectedMacroFile,
        saveInputText = SaveNameBox.Text
    }
    pcall(writefile, CONFIG_FILE, HttpService:JSONEncode(configData))
end

loadConfigFromFile = function()
    if not supportsFileSystem or not isfile(CONFIG_FILE) then return end
    local success, result = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    
    if success and typeof(result) == "table" then
        if result.autoPlaySingle ~= nil then isAutoPlaySingleEnabled = result.autoPlaySingle end
        updateAutoPlayUI()
        
        if result.autoReplay ~= nil then isAutoReplayEnabled = result.autoReplay end
        if result.autoLobby ~= nil then isAutoLobbyEnabled = result.autoLobby end
        updateEndGameUI()
        
        if result.autoVote ~= nil then
            isAutoVoteEnabled = result.autoVote
            AutoVoteBtn.Text = isAutoVoteEnabled and "Vote ON" or "Vote OFF"
            AutoVoteBtn.BackgroundColor3 = isAutoVoteEnabled and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(100, 40, 40)
        end
        
        if result.autoVoteDiff ~= nil then
            isAutoVoteDiffEnabled = result.autoVoteDiff
            AutoVoteDiffBtn.Text = isAutoVoteDiffEnabled and "Diff ON" or "Diff OFF"
            AutoVoteDiffBtn.BackgroundColor3 = isAutoVoteDiffEnabled and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(100, 40, 40)
        end
        
        if result.speedMultiplier ~= nil then
            currentSpeedMultiplier = result.speedMultiplier
            SpeedBtn.Text = "Speed: " .. currentSpeedMultiplier .. "x"
            SpeedBtn.BackgroundColor3 = (currentSpeedMultiplier > 1) and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(100, 40, 40)
        end
        
        if result.autoSummonAmount ~= nil then autoSummonAmount = result.autoSummonAmount end
        if autoSummonAmount > 0 then
            AutoSummonBtn.Text = string.format("Auto Summon (%dx): ON", autoSummonAmount)
            AutoSummonBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 40)
        end
        
        if result.autoPremSummonAmount ~= nil then autoPremSummonAmount = result.autoPremSummonAmount end
        if autoPremSummonAmount > 0 then
            AutoPremSummonBtn.Text = string.format("Prem Summon (%dx): ON", autoPremSummonAmount)
            AutoPremSummonBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 40)
        end
        
        if result.autoCrateAmount ~= nil then autoCrateAmount = result.autoCrateAmount end
        if autoCrateAmount > 0 then
            AutoCrateBtn.Text = string.format("Crate (%dx)", autoCrateAmount)
            AutoCrateBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 40)
        end
        
        if result.autoBuyCrateAmount ~= nil then autoBuyCrateAmount = result.autoBuyCrateAmount end
        if autoBuyCrateAmount > 0 then
            AutoBuyCrateBtn.Text = string.format("Buy Crate (%dx): ON", autoBuyCrateAmount)
            AutoBuyCrateBtn.BackgroundColor3 = Color3.fromRGB(40, 160, 40)
        end
        
        if result.autoAbility ~= nil then
            isAutoAbilityEnabled = result.autoAbility
            AutoAbilityBtn.Text = isAutoAbilityEnabled and "Auto Ability: ON" or "Auto Ability: OFF"
            AutoAbilityBtn.BackgroundColor3 = isAutoAbilityEnabled and Color3.fromRGB(40, 160, 40) or Color3.fromRGB(100, 40, 40)
        end
        
        if result.autoVoteSkip ~= nil then
            isAutoVoteSkipEnabled = result.autoVoteSkip
            AutoSkipBtn.Text = isAutoVoteSkipEnabled and "Auto Skip Wave: ON" or "Auto Skip Wave: OFF"
